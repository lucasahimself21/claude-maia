{
  "name": "claude-maia",
  "displayName": "Claude Maia",
  "description": "Lista plana das sessões do Claude Code (abre no chat da extensão oficial, mostra as abertas), uso do plano (5h/7d) na barra inferior e patches automáticos na extensão Claude Code (navegador automático, Ctx no chat, esconde o Session Manager). Fork de vscode-claude-sessions.",
  "version": "1.4.34",
  "publisher": "maia",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasahimself21/claude-maia.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:claudeSessionsExplorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeSessions.refresh",
        "title": "Refresh Claude Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.openSession",
        "title": "Open Claude Session",
        "icon": {
          "light": "media/terminal-green.svg",
          "dark": "media/terminal-green.svg"
        }
      },
      {
        "command": "claudeSessions.openSessionDangerously",
        "title": "Open Session (Skip Permissions)",
        "icon": {
          "light": "media/terminal-red.svg",
          "dark": "media/terminal-red.svg"
        }
      },
      {
        "command": "claudeSessions.openPromptPreview",
        "title": "Open Prompt Preview",
        "icon": "$(book)"
      },
      {
        "command": "claudeSessions.focusView",
        "title": "Focus Claude Sessions View"
      },
      {
        "command": "claudeSessions.search",
        "title": "Search Claude Sessions",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.clearFilter",
        "title": "Clear Session Filter",
        "icon": "$(close)"
      },
      {
        "command": "claudeSessions.renameSession",
        "title": "Rename Session",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSessions.deleteSession",
        "title": "Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSessions.clearSelection",
        "title": "Unselect All",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeSessions.viewSession",
        "title": "View Session",
        "icon": "$(eye)"
      },
      {
        "command": "claudeMaia.patchClaudeCode",
        "title": "Ativar Claude Maia",
        "category": "Claude Maia"
      },
      {
        "command": "claudeMaia.unpatchClaudeCode",
        "title": "Desativar Claude Maia (Claude Code original)",
        "category": "Claude Maia"
      },
      {
        "command": "claudeMaia.refreshUsage",
        "title": "Atualizar uso do plano (5h/7d)",
        "category": "Claude Maia"
      },
      {
        "command": "claudeMaia.update",
        "title": "Atualizar pela última release",
        "icon": "$(cloud-download)",
        "category": "Claude Maia"
      },
      {
        "command": "claudeMaia.checkUpdate",
        "title": "Atualizar",
        "category": "Claude Maia"
      },
      {
        "command": "claudeMaia.newChat",
        "title": "Novo chat",
        "category": "Claude Maia"
      },
      {
        "command": "claudeMaia.closeActiveEditor",
        "title": "Claude Maia: fechar a aba ativa (Cmd+W com trava contra fechamento duplo)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "claudeSessionsExplorer",
          "name": "Claude Maia",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeSessions.clearSelection",
          "when": "view == claudeSessionsExplorer && claudeSessions.hasCheckedSessions",
          "group": "navigation"
        },
        {
          "command": "claudeSessions.deleteSession",
          "when": "view == claudeSessionsExplorer && claudeSessions.hasCheckedSessions",
          "group": "navigation"
        },
        {
          "submenu": "claudeMaia.menu",
          "when": "view == claudeSessionsExplorer",
          "group": "navigation@9"
        }
      ],
      "claudeMaia.menu": [
        {
          "command": "claudeMaia.newChat",
          "group": "1_chat"
        },
        {
          "command": "claudeMaia.checkUpdate",
          "group": "2_update"
        },
        {
          "command": "claudeMaia.patchClaudeCode",
          "group": "3_toggle",
          "when": "!claudeMaia.enabled"
        },
        {
          "command": "claudeMaia.unpatchClaudeCode",
          "group": "3_toggle",
          "when": "claudeMaia.enabled"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeMaia.patchClaudeCode",
          "when": "false"
        },
        {
          "command": "claudeMaia.unpatchClaudeCode",
          "when": "false"
        },
        {
          "command": "claudeMaia.refreshUsage",
          "when": "false"
        },
        {
          "command": "claudeMaia.update",
          "when": "false"
        },
        {
          "command": "claudeMaia.checkUpdate",
          "when": "false"
        },
        {
          "command": "claudeMaia.newChat",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Maia",
      "properties": {
        "claudeSessions.confirmDangerousSkipPermissions": {
          "type": "boolean",
          "default": true,
          "description": "Show a required warning confirmation before launching Claude with --dangerously-skip-permissions."
        },
        "claudeMaia.patchClaudeCode": {
          "type": "boolean",
          "default": true,
          "description": "Claude Maia ativa na extensão Claude Code (aplica e reaplica os ajustes ao ativar, de hora em hora e quando ela atualiza). O item Ativar/Desativar da engrenagem muda isto."
        },
        "claudeMaia.claudeMdRules": {
          "type": "boolean",
          "default": true,
          "description": "Garante no ~/.claude/CLAUDE.md (bloco entre <!-- claude-maia:navegador -->) as regras do navegador: Claude in Chrome é o padrão, como reconectar sem fechar o Chrome (comandos do sistema: Mac, Windows ou Linux) e como tratar as abas. Conferido no mesmo ciclo dos patches."
        },
        "claudeMaia.patch.autoBrowser": {
          "type": "boolean",
          "default": true,
          "description": "Patch: navegador (Claude in Chrome) liga sozinho na primeira mensagem de cada chat."
        },
        "claudeMaia.patch.contextInChat": {
          "type": "boolean",
          "default": true,
          "description": "Patch: \"Ctx 36% (363k/1000k)\" sempre visível no rodapé do chat, cores da status line."
        },
        "claudeMaia.patch.hideSessionManager": {
          "type": "boolean",
          "default": true,
          "description": "Patch: esconde a barra lateral Session Manager da extensão Claude Code (a lista fica na Claude Maia)."
        },
        "claudeMaia.usageBar": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar uso do plano (5h/7d) na barra inferior. Vem do chat a cada resposta; a API só é consultada quando não há dado ou quando a janela resetou (clique na barra força)."
        },
        "claudeMaia.patch.contextFullWindow": {
          "type": "boolean",
          "default": true,
          "description": "Patch: o Ctx do chat conta sobre a janela inteira do modelo (1000k), igual à status line, em vez de descontar a reserva de saída."
        },
        "claudeMaia.patch.usageFromChat": {
          "type": "boolean",
          "default": true,
          "description": "Patch: a extensão Claude Code grava o uso do plano (5h/7d) que recebe a cada resposta em ~/.claude/claude-maia-usage.json; a barra lê dali sem consultar a API."
        },
        "claudeMaia.patch.chatLineHeight": {
          "type": "boolean",
          "default": true,
          "description": "Patch (CSS): entrelinha do chat da extensão Claude Code = claudeMaia.chatLineHeight."
        },
        "claudeMaia.chatLineHeight": {
          "type": "number",
          "default": 1.3,
          "description": "Entrelinha do chat (multiplicador). 0 = editor.lineHeight se for multiplicador."
        },
        "claudeMaia.chatFont": {
          "type": "boolean",
          "default": true,
          "description": "Grava chat.fontFamily/chat.fontSize e chat.editor.fontFamily/fontSize com os valores abaixo (a extensão Claude Code lê essas configs) e, no macOS, instala a JetBrains Mono pelo Homebrew se faltar."
        },
        "claudeMaia.chatFontFamily": {
          "type": "string",
          "default": "JetBrains Mono",
          "description": "Fonte do chat da extensão Claude Code."
        },
        "claudeMaia.chatFontSize": {
          "type": "number",
          "default": 13,
          "description": "Tamanho da fonte do chat, em px."
        },
        "claudeMaia.patch.renameTab": {
          "type": "boolean",
          "default": true,
          "description": "Patch: renomear uma sessão pela lista da Claude Maia renomeia a aba do chat aberta (usa o rename da própria extensão, sem input box)."
        },
        "claudeMaia.patch.renameTarget": {
          "type": "boolean",
          "default": true,
          "description": "Patch: o rename pela lista mira a sessão clicada, não o primeiro chat ativo (com chats lado a lado, todos são ativos no próprio grupo)."
        }
      }
    },
    "submenus": [
      {
        "id": "claudeMaia.menu",
        "label": "Claude Maia",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "key": "cmd+w",
        "mac": "cmd+w",
        "command": "claudeMaia.closeActiveEditor",
        "when": "claudeMaia.chatOpen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,mjs,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,mjs,md}\"",
    "copy-fixtures": "rm -rf out/test/fixtures && cp -r src/test/fixtures out/test/fixtures",
    "pretest": "npm run compile && npm run copy-fixtures",
    "test": "node ./out/test/runTest.js",
    "test:coverage": "c8 node ./out/test/runTest.js",
    "test:coverage:check": "c8 check-coverage --lines 60 --functions 60 --branches 60",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,mjs,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.8",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vscode/test-electron": "^3.1.0",
    "c8": "^10.1.3",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "typescript": "^5.6.2"
  }
}
